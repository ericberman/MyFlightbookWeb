@{
    ViewBag.defaultTab = tabID.tabLogbook;
    ViewBag.Title = "Debug Images";
    Layout = "~/Areas/mvc/Views/Shared/_Layout.cshtml";
    bool fOfferOCR = MyFlightbook.Payments.EarnedGratuity.UserQualifies(User.Identity.Name, MyFlightbook.Payments.Gratuity.GratuityTypes.FlightDeckScan);
}
<script type="text/javascript" src="@("~/Public/Scripts/ajaxUpload.js?v=11".ToAbsolute())"></script>
<script type="text/javascript">
    $(() => {
        ajaxFileUpload($("#uploadFile"), {
            uploadURL: "@Url.Action("ImageDebugResult", "PlayPen")",
            allowedTypes: "@MyFlightbook.Image.FileExtensions.AllowedExtensionsForTypes(true, false, false)",
            dragTargetClass: "fileDragTarget",
            additionalParams: [],
            maxFiles: 10,
            onFileUploaded: function (status, response) {
                $(".fileInQueueContainer").hide();
                $(response).appendTo($("#fileResults"));
            },
            onErr: function (err) { window.alert(err); },
            promptID: "divDropImages",
            errTooManyFiles: "@Resources.LocalizedText.fileUploadTooManyFiles",
            errDisallowedFileType: "@Resources.LocalizedText.fileUploadInvalidType",
            abortPrompt: "@Resources.LocalizedText.fileUploadAbort"
        });
    });
</script>
<div id="uploadFile"></div>
<div><button type="button" onclick="javascript: $('#fileResults').html(''); return false;">Clear results</button></div>
<div id="fileResults"></div>
<div id="divDropImages">
    <div>Debug images</div>
    <div><img src="@("~/images/camera.png".ToAbsolute())" /></div>
</div>

@if (fOfferOCR)
{
    <script type="text/javascript">
        $(() => {
            ajaxFileUpload($("#scanFile"), {
                uploadURL: "@Url.Action("ScanFlightDeckImage", "Image")",
                allowedTypes: "@MyFlightbook.Image.FileExtensions.AllowedExtensionsForTypes(true, false, false)",
                dragTargetClass: "fileDragTarget",
                // debug=1 asks the endpoint for the raw, pre-normalization model
                // read alongside the normalized result - safe here since this whole
                // block only renders for admins (fOfferOCR); ScanFlightDeckImage
                // re-checks admin status server-side regardless.
                additionalParams: [{ name: "debug", value: true }],
                maxFiles: 1,
                onFileUploaded: function (status, response) {
                    $(".fileInQueueContainer").hide();
                    $("#scanProgress").hide();
                    $("#divRawHeader").show();
                    $("#scanResults").text(JSON.stringify(response, null, 2));
                    if (response.success) {
                        $("#divCreatePending").show();
                        $("#txtScannedFlight").val(JSON.stringify(response.parsedResults, null, 2));
                    }
                },
                onPreSend: function (file) {
                    $("#txtScannedFlight").val("");
                    $("#divCreatePending").hide();
                    $("#scanProgress").show();
                },
                onErr: function (err) { window.alert(err); },
                promptID: "divScanImages",
                errTooManyFiles: "@Resources.LocalizedText.fileUploadTooManyFiles",
                errDisallowedFileType: "@Resources.LocalizedText.fileUploadInvalidType",
                abortPrompt: "@Resources.LocalizedText.fileUploadAbort"
            });
        });
    </script>
    <hr />
    <h2>Test images of flight deck screens (ACARS, OOOI, MCDU, etc.)</h2>
    <div id="scanFile"></div>
    <div id="divScanImages">
        <div><img src="@("~/images/ACARS-sm.png".ToAbsolute())" /></div>
    </div>
    <div id="scanProgress" class="dn"><img src="@("~/images/progress.gif".ToAbsolute())" /></div>
    <div class="dn" id="divCreatePending">
        <hr />
        <h3>Flight details found!</h3>
        @using (Html.BeginForm("Flight", "FlightEdit", FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
            <div><textarea name="srcScan" required id="txtScannedFlight" rows="5" class="w100"></textarea></div>
            <button type="submit">Initialize a new flight from this</button>
        }
    </div>
    <h3 id="divRawHeader" class="dn">Raw results:</h3>
    <div id="scanResults" class="wsprew"></div>
}
